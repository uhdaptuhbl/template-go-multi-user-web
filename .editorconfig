# Editor defaults, so that formatting does not depend on whose editor saved a
# file. Go's own tooling is authoritative for .go files; this only stops an
# editor from fighting it before gofmt runs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# gofmt indents with tabs and does not care about width; 4 is only what an
# editor renders.
indent_style = tab
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown, so trimming them
# silently changes rendered output.
trim_trailing_whitespace = false
max_line_length = 95

[Makefile]
indent_style = tab

[*.{yml,yaml,json,js,ts,css,html}]
indent_style = space
indent_size = 2
