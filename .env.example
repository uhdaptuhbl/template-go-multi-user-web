# Service configuration.
#
# Every value below is the default the process uses when the variable is unset,
# so a copy of this file with nothing uncommented changes no behaviour. Copy it
# to .env, uncomment what you need, and change it there; .env is gitignored.
#
# Nothing in the process reads this file. Configuration is read from the real
# environment (see docs/adr/0006-configuration-loading.md), so load it with
# something that exports it:
#
#   docker run --env-file .env ...
#   set -a; . ./.env; set +a; go run ./cmd/service
#
# A variable that is set but empty counts as unset, so an exported-but-empty
# value cannot blank a listen address.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug, info, warn, or error.
#SERVICE_LOG_LEVEL=info

# console for human-readable output, json for ingestion.
#SERVICE_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Application listener
#
# Serves users: the embedded frontend, /healthz, and /readyz.
# ---------------------------------------------------------------------------

#SERVICE_SERVER_ADDR=:8080

# Request-line-plus-headers and request-body ceilings. A plain number is a
# count of bytes; a suffix may be given instead, either binary (KiB, MiB, GiB,
# TiB) or decimal (KB, MB, GB, TB). Whole numbers only: 1.5MiB is refused
# rather than rounded.
#SERVICE_SERVER_MAX_HEADER_BYTES=1MiB
#SERVICE_SERVER_MAX_REQUEST_BODY_BYTES=1MiB

# Concurrent request cap; 0 disables it.
#SERVICE_SERVER_MAX_IN_FLIGHT=0

# Per-request handler deadline; 0 disables it. When set it must be shorter than
# SERVICE_SERVER_WRITE_TIMEOUT, which is the deadline that would otherwise cut
# the connection before the handler could act on being cancelled.
#SERVICE_SERVER_HANDLER_TIMEOUT=0s

# Connection timeouts. Tuned to release resources held by stalled clients
# without interrupting ordinary requests, so changing them is rarely necessary.
# READ_TIMEOUT covers the whole request, headers included, so it must be at
# least READ_HEADER_TIMEOUT.
#SERVICE_SERVER_READ_HEADER_TIMEOUT=5s
#SERVICE_SERVER_READ_TIMEOUT=30s
#SERVICE_SERVER_WRITE_TIMEOUT=30s
#SERVICE_SERVER_IDLE_TIMEOUT=120s
#SERVICE_SERVER_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Administrative listener
#
# Serves operators: /metrics, /debug/pprof/, /healthz, and /readyz. It binds
# loopback on purpose. Moving it off loopback exposes profiling endpoints that
# will dump the heap, every goroutine's stack, and the process command line to
# anyone who can reach them, so it needs a network policy in front of it.
# ---------------------------------------------------------------------------

#SERVICE_ADMIN_ADDR=127.0.0.1:9090

# The SERVICE_SERVER_* limits and timeouts above all have SERVICE_ADMIN_*
# counterparts that configure this listener the same way.

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------

# How long readiness keeps failing before the listeners stop accepting, so a
# load balancer has time to notice. terminationGracePeriodSeconds must exceed
# this plus SERVICE_SERVER_SHUTDOWN_TIMEOUT.
#SERVICE_LIFECYCLE_PRE_DRAIN_DELAY=5s

# ---------------------------------------------------------------------------
# Proxy trust
# ---------------------------------------------------------------------------

# Comma-separated CIDRs whose X-Forwarded-For and X-Request-Id headers are
# believed. Empty means trust nothing, so an unconfigured deployment cannot be
# lied to about where a request came from. See
# docs/adr/0008-proxy-trust-and-request-identity.md.
#
# Each entry is a network, not an address: 10.0.0.0/8, not 10.0.0.1. One that
# does not parse stops the process at startup. A trailing comma is harmless.
#SERVICE_PROXY_TRUSTED_CIDRS=

# ---------------------------------------------------------------------------
# Telemetry
#
# These carry no project prefix: the OpenTelemetry specification fixes their
# names. Tracing stays off until an endpoint is set.
# ---------------------------------------------------------------------------

#OTEL_SERVICE_NAME=service
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
